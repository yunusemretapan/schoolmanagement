{
  "name": "@schoolos/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.yaml -o src/schema.ts",
    "contract:check": "openapi-typescript openapi.yaml -o src/schema.ts --check",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "vitest": "5.0.0"
  }
}
