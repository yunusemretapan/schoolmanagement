# Web (Vite) environment — copy to apps/web/.env.local (gitignored). Addresses, not secrets.
# Vite reads .env files from this app's folder, not from frontend/ (docs/conventions.md, Known traps).

# Empty: the app calls its own origin; `npm run dev -w @schoolos/web` proxies /api to :8080.
VITE_API_BASE_URL=
