{
  "name": "@schoolos/mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@schoolos/api-client": "*",
    "@schoolos/auth": "*",
    "@schoolos/design-tokens": "*",
    "@tanstack/react-query": "5.108.0",
    "expo": "~58.0.26",
    "expo-font": "~58.0.12",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "i18next": "27.1.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "18.0.2",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "30.5.2",
    "jest-expo": "~58.0.15",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit -p .",
    "test": "jest --ci --watchman=false --maxWorkers=2",
    "export:web": "expo export --platform web"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/src/test/setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@schoolos/.*|react-native-web)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/afterEnv.ts"
    ],
    "resolver": "react-native-reanimated/jest/resolver"
  }
}
