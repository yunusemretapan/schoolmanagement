# Mobile (Expo) environment — copy to apps/mobile/.env.local (gitignored). Addresses, not secrets.
# Expo reads .env files from this app's folder, not from frontend/ (docs/conventions.md, Known traps).

# localhost only works for the iOS simulator / Expo web on the same machine.
# Android emulator: http://10.0.2.2:8080 · physical device: http://<your-computer-LAN-IP>:8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
