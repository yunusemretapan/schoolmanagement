<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.schoolos</groupId>
  <artifactId>schoolos-backend</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>schoolos-backend</name>

  <modules>
    <module>core/core-crosscutting</module>
    <module>core/core-security</module>
    <module>core/core-application</module>
    <module>core/core-persistence</module>
    <module>domain</module>
    <module>application</module>
    <module>persistence</module>
    <module>webapi</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <error-prone.version>2.52.0</error-prone.version>
    <palantir-java-format.version>2.103.0</palantir-java-format.version>
    <spotless.version>3.11.0</spotless.version>
    <enforcer.version>3.7.0</enforcer.version>
    <!-- Argon2id (spring-security-crypto) needs Bouncy Castle; not managed by the Boot BOM. MIT-style licence. -->
    <bouncycastle.version>1.87</bouncycastle.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.schoolos</groupId>
        <artifactId>core-crosscutting</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.schoolos</groupId>
        <artifactId>core-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.schoolos</groupId>
        <artifactId>core-application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.schoolos</groupId>
        <artifactId>core-persistence</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.schoolos</groupId>
        <artifactId>domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.schoolos</groupId>
        <artifactId>application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.schoolos</groupId>
        <artifactId>persistence</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Unit tests only (ADR 0003): every module gets JUnit 5 + AssertJ + Mockito. -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${java.version}</release>
          <compilerArgs>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <arg>-Xplugin:ErrorProne</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${error-prone.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <palantirJavaFormat>
              <version>${palantir-java-format.version}</version>
            </palantirJavaFormat>
            <removeUnusedImports/>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
