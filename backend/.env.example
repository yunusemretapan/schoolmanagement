# Backend local environment — copy to backend/.env (gitignored). Values here are placeholders, never real secrets.
# docker compose reads this file; for the app export the same names (or use the dev profile defaults).

# Postgres superuser (bootstrap only) and the application role's password (compose.yaml).
POSTGRES_PASSWORD=change-me-local
DB_PASSWORD=change-me-local

# Application (application.yml). DB_URL / DB_USER default to the compose database.
# DB_URL=jdbc:postgresql://localhost:5432/schoolos
# DB_USER=schoolos_app
# JWT_SECRET: at least 32 random bytes, base64. Required outside the dev profile.
# JWT_SECRET=
# CORS_ALLOWED_ORIGINS: comma-separated browser origins allowed to call the API (e.g. Expo web).
# CORS_ALLOWED_ORIGINS=http://localhost:8081
